[Body Rewrite]
# 1. 首页：移除金刚区、顶部大促标签（如11.11大促）、拼小圈横条与异形横幅，保留多多买菜、百亿补贴与3栏底栏（首页/聊天/个人中心）
http-response-jq (?i)^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/alexa\/homepage\/hub(\/refresh)?(\?|$) 'if (.result? | type) == "object" then del(.result.icon_set, .result.slide_icon_set, .result.icon_fold_zone, .result.home_screen_skin.timeline, .result.dy_module.irregular_banner_dy) | .result.timeline_visible = false | .result.timeline_in_white = false | if (.result.module_order? | type) == "array" then .result.module_order |= map(select((.module_name? // "") | IN("irregular_banner","irregular_banner_dy","timeline","icon_set","ad_module") | not)) else . end | if (.result.all_top_opts? | type) == "array" then (.result.all_top_opts | map(select((.tab_id? // 0) | IN(1, 2)) | del(.selected_image, .image, .height, .width))) as $t | if ($t | length) > 0 then .result.all_top_opts = $t else . end else . end | if (.result.bottom_tabs? | type) == "array" then (.result.bottom_tabs | map(select(((.link? // "") | tostring | (split("?")[0] // "") | (split("#")[0] // "")) | IN("index.html","chat_list.html","personal.html")))) as $k | if ($k | length) > 0 then .result.bottom_tabs = $k else . end else . end | if (.result.buffer_bottom_tabs? | type) == "array" then (.result.buffer_bottom_tabs | map(select(((.link? // "") | tostring | (split("?")[0] // "") | (split("#")[0] // "")) | IN("index.html","chat_list.html","personal.html")))) as $k2 | if ($k2 | length) > 0 then .result.buffer_bottom_tabs = $k2 else . end else . end else . end'

# 1b. 首页拼小圈横条入口（清除入口对象并隐藏开关）
http-response-jq (?i)^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/social\/timeline\/v4\/get\/entrance(\?|$) 'if (type == "object") then del(.entrance, .entrance_icon_image, .timeline_jump_url) else . end'
http-response-jq (?i)^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/social\/my\/info(\?|$) 'if (type == "object") then .hide_entrance = true | .unopen_display_timeline = false else . end'

# 2. 全局活动/红包/优惠券弹窗（兼容 aquarius/flow 与 window/global 路径，清空 list 与 backup_data）
http-response-jq (?i)^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/(aquarius|flow)\/hungary\/(window\/)?global\/ 'if (type == "object") then del(.backup_data) | if (.list? | type) == "array" then .list = [] else . end | if (.result? | type) == "object" and (.result.list? | type) == "array" then .result.list = [] else . end else . end'

# 3. 个人中心：置空第二排服务推广图标与横幅，移除缓存策略与专属客服入口（保留省钱月卡与订单/收藏/优惠券/收货地址/设置）
http-response-jq (?i)^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/philo\/personal\/hub(\?|$) 'if (type == "object") then del(.personal_banner, .personal_center_style_v2_vo) | .show_recommend_feed_banner = false | if (.icon_set? | type) == "object" then del(.icon_set.cache_strategy) | .icon_set.icons = [] | .icon_set.top_personal_icons = [] | if (.icon_set.third_personal_icons? | type) == "array" then .icon_set.third_personal_icons |= map(select(.app_name != "customer_service")) else . end else . end else . end'

# 4. 推送/拉新横幅兜底（限时秒杀/大促优惠/9块9特卖横幅）
http-response-jq (?i)^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/growth\/nagato\/app\/index\/gather(\?|$) 'if (type == "object" and has("newer_index_banner")) then .newer_index_banner = {"valid_data":false} else . end | if (type == "object" and has("push_banner")) then .push_banner = {"valid_data":false} else . end'

# 5. 聊天页顶部推广资源位（返回标准空成功响应，主动覆盖本地横幅缓存）
http-response-jq (?i)^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/zaire_biz\/chat\/resource\/get_list_data(\?|$) '{"success":true,"error_code":1000000,"result":{}}'

[Map Local]
# 6. 开屏广告与 H5 红包现金弹窗页
(?i)^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/cappuccino\/splash(\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/m\.pinduoduo\.net\/vlayer_tab_popup\.html(\?|$) data-type=text data="" status-code=200 header="Content-Type:text/html"

# 7. 个人中心：移除下方双列推荐商品流
(?i)^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/caterham\/v3\/query\/personal(\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 8. 聊天页：移除下方双列推荐商品流
(?i)^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/caterham\/v3\/query\/new_chat_group(\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 9. 兜底商品推荐流（彻底拦截 personal / new_chat_group 为空后触发的 back_up 兜底商品流）
(?i)^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/alexa\/goods\/back_up(\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 10. 网络信道策略扩展探测与桌面限时秒杀快捷方式
(?i)^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/phantom\/gbdbpdv\/extra(\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/manufacturer\/cross\/shortcut\/list(\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api.pinduoduo.com, api.yangkeduo.com, m.pinduoduo.net
