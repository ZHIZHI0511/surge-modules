#!name=拼多多精准去广告（首页精简/聊天/个人中心/全局弹窗）
#!desc=基于 8.33.0 真机 HAR 实抓精准定制：①首页移除金刚区、顶部大促标签（11.11等）、拼小圈横条、多多买菜横排、百亿补贴横排与异形横幅，保留3栏底栏②个人中心置空推广图标/横幅与30天缓存策略，移除专属客服入口并保留省钱月卡与常用功能栏③彻底拦截个人中心与聊天页推荐流及 goods/back_up 兜底推荐流④聊天页顶部资源位覆写空成功响应⑤拦截开屏、全局弹窗及 H5 红包弹窗页⑥全量封堵 HTTPDNS/QUIC/xg/meta/titan*/api-ipv6 及三网裸 IPv4/IPv6 长连接（全线采用 REJECT-NO-DROP 防止静默丢包触发刷新回退）。更新后请先在拼多多「设置→清除缓存」再彻底杀掉后台重进。
#!system=ios

[Rule]
# 拦截拼多多 HTTPDNS（兼容 /d、/d5 与 8.33.0 新版 /v3/d），使用 REJECT-NO-DROP 避免触发 REJECT-DROP 静默卡顿与回退
AND,((URL-REGEX, "^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\/(v\d+\/)?d(\d)?"), (USER-AGENT, "*com.xunmeng.pinduoduo*")),REJECT-NO-DROP
AND,((URL-REGEX, "^http:\/\/\[[0-9a-fA-F:]+\]\/(v\d+\/)?d(\d)?\?"), (USER-AGENT, "*com.xunmeng.pinduoduo*")),REJECT-NO-DROP

# 整站拦截拼多多 QUIC (UDP 443)，强制回落至标准 HTTPS 供 MITM 捕获
AND,((DOMAIN-SUFFIX, pinduoduo.com), (PROTOCOL, QUIC)),REJECT-NO-DROP
AND,((DOMAIN-SUFFIX, yangkeduo.com), (PROTOCOL, QUIC)),REJECT-NO-DROP
AND,((DOMAIN-SUFFIX, pinduoduo.net), (PROTOCOL, QUIC)),REJECT-NO-DROP

# 拦截拼多多信道探测、动态调度、QUIC 入口与全部 Titan 长连接域名（使用 REJECT-NO-DROP 立即回 RST 迫使回落 HTTPS）
DOMAIN,meta.pinduoduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,xg.pinduoduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,quic.pinduoduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,titan.pinduoduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,titan-mt.pinduoduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,titan-im.pinduoduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,titan-a.pinduoduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,titan-b.pinduoduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,titan-c.pinduoduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,titan-v2.pinduoduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,titan.yangkeduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,titan-mt.yangkeduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,titan-im.yangkeduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,longlink.pinduoduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,api-ipv6.pinduoduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,api-ipv6.yangkeduo.com,REJECT-NO-DROP,pre-matching

# 拦截拼多多埋点与网络诊断上报域名
DOMAIN,apm.pinduoduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,apm-a.pinduoduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,th.pinduoduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,th-a.pinduoduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,th-b.pinduoduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,ta.pinduoduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,ta-a.pinduoduo.com,REJECT-NO-DROP,pre-matching
DOMAIN,abtk.pinduoduo.com,REJECT-NO-DROP,pre-matching

# 拦截拼多多 Titan / HTTPDNS / 三网裸 IPv4/IPv6 直连通道（no-resolve 仅拦截绕过 DNS 的裸 IP 长连接/QUIC，不影响正常域名 HTTPS）
IP-CIDR,49.51.78.195/32,REJECT-NO-DROP,no-resolve
