#!name=元道经纬相机去广告-测试版 v2
#!desc=v2：在实测 vista.divms.cn/adn/v2/getAd 基础上，补齐已核实的元道广告SDK源（admin.hzjizhun.cn/infoConfig/833269、shunchangzhixing.com、sdk.hzzfcm.com、show-api/logrcv/usr-api.yunxish.com）。不修改定位、天气、拍照及 api.lbs.wintaosaas.com 团队业务接口。异常时禁用本模块即可回滚。

[Rule]
DOMAIN-SUFFIX,shunchangzhixing.com,REJECT
DOMAIN,admin.hzjizhun.cn,REJECT
DOMAIN,sdk.hzzfcm.com,REJECT
DOMAIN-SUFFIX,yunxish.com,REJECT

[URL Rewrite]
^https://vista\.divms\.cn/adn/v2/getAd(?:\?|$) _ reject
^http://admin\.hzjizhun\.cn/(?:infoConfig|errorReport)/833269(?:\?|$) _ reject

[MITM]
hostname = %APPEND% vista.divms.cn
